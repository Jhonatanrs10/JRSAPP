{
  "expo": {
    "name": "JRSAPP",
    "slug": "JRSAPP",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "jrsapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.jhonatanrs10.JRSAPP"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "899e2300-788e-46d1-9724-c6bc377656f6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/899e2300-788e-46d1-9724-c6bc377656f6"
    }
  }
}